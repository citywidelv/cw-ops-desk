/** Snow and Ice Service Reports (kind: snow_report). Rows land on the Snow Reports tab of the CW Maintenance Work Tickets Sheet; email goes to the Northern Nevada service line with reply-to the vendor. Added Aug 2026. */
var SNOW_HEADERS=['Paid?','Report #','Received','Company','Crew Lead','Email','Phone','Property','Address','Date of Service','Arrived','Departed','On-Site Hours','Headcount','Work Performed','Description','Truck Hours','People Shoveling','Shovel Hours','Ice Melt Bags','GPS Lat','GPS Lng','GPS Accuracy (m)','Map Link','Certified','Notes','Status'];
function snowSetup(){var props=PropertiesService.getScriptProperties();var ss=SpreadsheetApp.openById(props.getProperty('SHEET_ID'));var sh=ss.getSheetByName('Snow Reports');if(!sh)sh=ss.insertSheet('Snow Reports');if(sh.getMaxColumns()<SNOW_HEADERS.length)sh.insertColumnsAfter(sh.getMaxColumns(),SNOW_HEADERS.length-sh.getMaxColumns());sh.getRange(1,1,1,SNOW_HEADERS.length).setValues([SNOW_HEADERS]).setFontWeight('bold').setFontColor('#FFFFFF').setBackground(RED).setVerticalAlignment('middle').setWrap(false);sh.setRowHeight(1,34);sh.setFrozenRows(1);sh.setFrozenColumns(2);sh.getRange(2,1,Math.max(sh.getMaxRows()-1,1),1).insertCheckboxes();snowRule(sh);return 'snow setup ok: '+ss.getUrl();}
function snowRule(sh){var rule=SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=$A2=TRUE').setBackground('#CCEBEC').setRanges([sh.getRange(2,1,Math.max(sh.getMaxRows()-1,1),SNOW_HEADERS.length)]).build();sh.setConditionalFormatRules([rule]);}
function handleSnowReport(d){var props=PropertiesService.getScriptProperties();var ss=SpreadsheetApp.openById(props.getProperty('SHEET_ID'));var sh=ss.getSheetByName('Snow Reports');if(!sh){snowSetup();sh=ss.getSheetByName('Snow Reports');}var tz='America/Los_Angeles';var now=new Date();var rid='SNOW-'+Utilities.formatDate(now,tz,'yyyyMMdd-HHmmss');var t={company:clean(d.company,120),name:clean(d.name,80),email:clean(d.email,120),phone:clean(d.phone,40),property:clean(d.property_name,200),address:clean(d.address,300),dateOfService:prettyDate(clean(d.date_of_service,40)),arrive:prettyTime(clean(d.arrive_time,20)),depart:prettyTime(clean(d.depart_time,20)),onsite:clean(d.onsite_hours,20),headcount:clean(d.headcount,10),work:clean(d.work_performed,300),desc:clean(d.description,4000),truckHours:clean(d.truck_hours,20),shovelers:clean(d.shovelers,10),shovelHours:clean(d.shovel_hours,20),bags:clean(d.ice_melt_bags,20),lat:clean(d.geo_lat,30),lng:clean(d.geo_lng,30),acc:clean(d.geo_accuracy_m,20),map:clean(d.maps_link,200),certified:clean(d.certified,10),notes:clean(d.notes,2000)};if(!t.company)throw new Error('Company name is required');if(!t.name)throw new Error('Crew lead name is required');if(!t.email||t.email.indexOf('@')<1)throw new Error('A valid email is required');if(!t.property)throw new Error('Property name is required');if(!t.address)throw new Error('Service address is required');if(!t.desc)throw new Error('Describe the work performed');var tH=parseFloat(t.truckHours)||0;var sH=parseFloat(t.shovelHours)||0;if(tH<=0&&sH<=0)throw new Error('Truck hours or shovel hours must be above 0');var row=[false,rid,Utilities.formatDate(now,tz,'MMM d, yyyy h:mm a'),t.company,t.name,t.email,t.phone,t.property,t.address,t.dateOfService,t.arrive,t.depart,t.onsite,t.headcount,t.work,t.desc,t.truckHours,t.shovelers,t.shovelHours,t.bags,t.lat,t.lng,t.acc,t.map,t.certified,t.notes,'New'];sh.insertRowAfter(1);var nr=sh.getRange(2,1,1,row.length);nr.clearFormat();nr.setValues([row]);sh.getRange(2,1).insertCheckboxes();snowRule(sh);try{sendSnowEmail(t,rid);}catch(merr){sh.getRange(2,SNOW_HEADERS.length).setValue('EMAIL FAILED: '+merr);}return {ok:true,report_id:rid};}
function sendSnowEmail(t,rid){var subject='Snow Report '+rid+' | '+t.property+' | Truck '+(t.truckHours||'0')+' hrs | Shovel '+(t.shovelHours||'0')+' hrs | '+(t.bags||'0')+' bags';var gps=t.lat?(t.lat+', '+t.lng+' (within about '+t.acc+' m)'):'NOT PROVIDED - verify with the vendor before paying';var html='<div style="margin:0;padding:24px;background:'+LIGHT+';font-family:Verdana,Geneva,sans-serif">'+'<table role="presentation" cellpadding="0" cellspacing="0" style="max-width:640px;margin:0 auto;background:#ffffff;border:1px solid '+BORDER+';border-top:5px solid '+RED+';border-radius:10px;overflow:hidden;width:100%">'+'<tr><td style="padding:20px 22px 14px"><img src="'+LOGO+'" alt="City Wide Facility Solutions" height="38" style="height:38px;width:auto;display:block"></td></tr>'+'<tr><td style="padding:0 22px 4px;font-size:16px;font-weight:bold">Snow Service Report: '+esc(t.property)+'</td></tr>'+'<tr><td style="padding:0 22px 10px;font-size:12px;color:'+GREY+'">'+esc(rid)+' | Vendor pay is calculated from this report</td></tr>'+'<tr><td style="padding:6px 22px 10px"><table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border:1px solid '+BORDER+';border-radius:8px">'+fld('Property',t.property)+fld('Address',t.address)+fld('Date of Service',t.dateOfService)+fld('On Site',t.arrive+' to '+t.depart+' ('+t.onsite+' hrs)')+fld('Crew On Site',t.headcount)+fld('Work Performed',t.work)+fld('Details',t.desc)+'</table></td></tr>'+'<tr><td style="padding:8px 22px 4px"><div style="font-size:11px;font-weight:bold;color:'+RED+';text-transform:uppercase;letter-spacing:.08em">Billable, by the actual-use rules</div></td></tr>'+'<tr><td style="padding:6px 22px 10px"><table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border:1px solid '+BORDER+';border-radius:8px">'+fld('Truck Hours (actually plowing or spreading)',t.truckHours)+fld('People Shoveling',t.shovelers)+fld('Shovel Labor Hours (all people combined)',t.shovelHours)+fld('Ice Melt Bags Used (50 lb.)',t.bags)+'</table></td></tr>'+'<tr><td style="padding:6px 22px 10px"><table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;border:1px solid '+BORDER+';border-radius:8px">'+fld('GPS Check-In',gps)+linksRow('Map',t.map?[t.map]:[])+fld('Certified Accurate By Vendor',t.certified)+fld('Notes',t.notes)+'</table></td></tr>'+'<tr><td style="padding:0 22px 24px;font-size:11px;color:'+GREY+'">Logged automatically to the Snow Reports tab of the CW Maintenance Work Tickets sheet. Reply to this email to reach the vendor directly. <span style="font-style:italic;font-weight:bold">GoCityWide.com</span></td></tr>'+'</table></div>';cwRemoteMail_('snow_int',{to:RN_EMAIL,replyTo:t.email||RN_EMAIL,subject:subject,htmlBody:html,body:'Snow Report '+rid+' - '+t.property+' - Truck '+t.truckHours+' hrs - Shovel '+t.shovelHours+' hrs - '+t.bags+' bags'});}
function prettyDate(s){var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s||''));if(!m)return s;var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return months[Number(m[2])-1]+' '+Number(m[3])+', '+m[1];}
function prettyTime(s){var m=/^(\d{1,2}):(\d{2})$/.exec(String(s||''));if(!m)return s;var h=Number(m[1]),ap=h>=12?'PM':'AM';h=h%12;if(h===0)h=12;return h+':'+m[2]+' '+ap;}